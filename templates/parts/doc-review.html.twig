{# Codex+ — auditor responsável, revisor e janela de revisão (bloco R3d).
   Decisão de Claudio, 21/09/2026: validação em duas etapas (1ª o
   responsável, 2ª o auditor responsável; P1, 26/09/2026) e revisão periódica com um papel próprio
   (revisor) e uma janela no calendário, com início e fim.
   Entra dentro de um .cx-docform-grid: na criação e na edição (formulário
   do documento) e, fora de rascunho, no formulário "Salvar revisão
   periódica". Desde a A1 (Claudio, 25/09/2026) a lista de auditores vem do
   perfil (bit Auditor), não do setor: não depende das categorias.
   Variável: review (ver front/document.form.php). #}

{# P2: auditor só no fluxo completo; revisão periódica fora do fluxo direto. #}
{% if review.show_auditor %}
<div class="cx-docform-field cx-docform-field--wide"{% if review.is_new %} data-cx-only-type="{{ review.auditor_types }}"{% endif %}>
    <label>{{ __('Auditor responsável', 'codexplus') }}</label>
    {% if review.can_auditor %}
        {{ review.auditor_widget|raw }}
        <div class="codexplus-form-hint">
            {% if review.no_auditors %}
                {{ __('Ninguém tem perfil de auditor nesta entidade. O auditor é quem tem a coluna Auditor marcada no perfil (Administração → Perfis → aba Codex+). Dá para escolher depois, antes de enviar para validação.', 'codexplus') }}
            {% else %}
                {{ __('2ª etapa: aprova e publica, ou devolve com o que corrigir. Não edita. Aparece quem tem o direito Auditar.', 'codexplus') }}
            {% endif %}
        </div>
    {% else %}
        <div class="cx-docform-readonly">{{ review.auditor_name ?: '—' }}</div>
        <div class="codexplus-form-hint">{{ __('O auditor responsável só muda em rascunho, por quem gere o documento.', 'codexplus') }}</div>
    {% endif %}
</div>
{% endif %}

{% if review.show_reviewer %}
<div class="cx-docform-field cx-docform-field--wide cx-review"{% if review.is_new %} data-cx-only-type="{{ review.reviewer_types }}"{% endif %}>
    <label>{{ __('Revisão periódica', 'codexplus') }}</label>
    {% if review.can_review %}
        <div class="cx-review-grid">
            <div>
                <span class="cx-review-lbl">{{ __('Revisor', 'codexplus') }}</span>
                {{ review.reviewer_widget|raw }}
            </div>
            <div>
                <span class="cx-review-lbl">{{ __('De', 'codexplus') }}</span>
                <input type="date" name="review_start" value="{{ review.start }}" class="form-control">
            </div>
            <div>
                <span class="cx-review-lbl">{{ __('Até', 'codexplus') }}</span>
                <input type="date" name="review_end" value="{{ review.end }}" class="form-control">
            </div>
        </div>
        <div class="codexplus-form-hint">
            {% if review.is_new %}
                {{ __('Em branco, a janela é calculada na publicação pela validade do tipo (POP e PSG 12 meses, Manual 6, Diagrama 3): termina nesse prazo e começa 30 dias antes do fim. Proposta: defina as duas datas.', 'codexplus') }}
            {% elseif review.validity_months > 0 %}
                {{ __('Em branco, a janela é calculada na publicação: termina %d meses depois e começa 30 dias antes do fim. O documento vence no fim da janela.', 'codexplus')|format(review.validity_months) }}
            {% else %}
                {{ __('Este tipo não tem validade padrão: defina as duas datas.', 'codexplus') }}
            {% endif %}
        </div>
    {% else %}
        <div class="cx-docform-readonly">
            {{ review.reviewer_name ?: '—' }}
            {% if review.start and review.end %}· {{ review.start|date('d/m/Y') }} {{ __('a', 'codexplus') }} {{ review.end|date('d/m/Y') }}{% endif %}
        </div>
    {% endif %}
</div>
{% endif %}
