{# Codex+ — coluna "Permissões" da página do documento.
   Layout decidido por Claudio em 20/09/2026: fica na própria página, à
   direita de Categorias e Responsável, e não em abas.
   R3b2-a: LEITURA (grupo, perfil, usuário), e a coluna já na criação.
   A seção EDIÇÃO saiu na P1 (editam responsável, revisor e autor).

   Não é formulário: pode estar dentro do formulário de edição ou fora dele
   (documento publicado). Documento existente: tudo vai por
   public/js/codexplus-perm.js para ajax/document.targets.php, que confere de
   novo quem pode. Criação (perm.pending): o documento ainda não existe, então
   o JS só monta a lista e grava cada escolha num campo _cxn_perm[] ("tipo:id")
   dentro do formulário; o controller grava depois do "Criar rascunho".
   A marcação dos itens da lista é repetida no JS (itemHtml): mudou uma,
   mude a outra.

   Variáveis: perm (show, pending, can_manage, targets, widgets, url),
   id, csrf_token; anon (R7, null = sem a seção). #}
{% set icone = {'group': 'ti-users', 'profile': 'ti-id-badge-2', 'user': 'ti-user', 'editor_user': 'ti-user', 'editor_group': 'ti-users'} %}
{% set rotulo = {'group': __('Grupo', 'codexplus'), 'profile': __('Perfil', 'codexplus'), 'user': __('Usuário', 'codexplus'), 'editor_user': __('Usuário', 'codexplus'), 'editor_group': __('Grupo', 'codexplus')} %}
{% set secoes = [
    {
        'chave': 'leitura',
        'titulo': __('Leitura', 'codexplus'),
        'itens': perm.targets,
        'tipos': ['group', 'profile', 'user'],
        'vazio': __('Nenhum leitor. Só quem tem papel no documento o vê.', 'codexplus'),
        'dica': __('Leitores só veem a versão publicada. Grupo e perfil valem em todas as entidades.', 'codexplus'),
    }
] %}
<aside class="cx-perm{{ perm.pending ? ' cx-perm--pending' : '' }}" data-cx-perm data-url="{{ perm.url }}" data-doc="{{ id }}"
       data-manage="{{ perm.can_manage ? '1' : '0' }}" data-pending="{{ perm.pending ? '1' : '0' }}"
       aria-label="{{ __('Permissões', 'codexplus') }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

    <h3 class="cx-perm-title"><i class="ti ti-lock-access"></i> {{ __('Permissões', 'codexplus') }}</h3>

    {% for sec in secoes %}
        <div class="cx-perm-block" data-cxp-sec="{{ sec.chave }}">
            <div class="cx-perm-sub">{{ sec.titulo }}</div>
            <ul class="cx-perm-list" data-cxp-list>
                {% for t in sec.itens %}
                    <li class="cx-perm-item" data-tipo="{{ t.tipo }}" data-ligacao="{{ t.ligacao }}">
                        <i class="ti {{ icone[t.tipo] ?? 'ti-user' }}" title="{{ rotulo[t.tipo] ?? '' }}"></i>
                        <span class="cx-perm-name">{{ t.nome }}</span>
                        {% if perm.can_manage %}
                            <button type="button" class="cx-perm-del" data-cxp-del
                                    aria-label="{{ __('Tirar', 'codexplus') }} {{ t.nome }}" title="{{ __('Tirar', 'codexplus') }}">
                                <i class="ti ti-x"></i>
                            </button>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            <p class="cx-perm-empty" data-cxp-empty {% if sec.itens %}hidden{% endif %}>{{ sec.vazio }}</p>

            {% if perm.can_manage %}
                <div class="cx-perm-add">
                    {% for tipo in sec.tipos %}
                        <div class="cx-perm-row">
                            <label class="cx-perm-lbl">{{ rotulo[tipo] }}</label>
                            <div class="cx-perm-sel" data-cxp-sel="{{ tipo }}">{{ perm.widgets[tipo]|raw }}</div>
                            <button type="button" class="codexplus-btn cx-perm-addbtn" data-cxp-add="{{ tipo }}">
                                <i class="ti ti-plus"></i> {{ __('Adicionar', 'codexplus') }}
                            </button>
                        </div>
                    {% endfor %}
                </div>
                <div class="codexplus-form-hint">{{ sec.dica }}</div>
            {% endif %}
        </div>
    {% endfor %}

    {# R7: link secreto de leitura sem login (anon = null: não gere o link). #}
    {% if anon|default(null) is not null %}
        <div class="cx-perm-block cx-anon">
            <div class="cx-perm-sub">{{ __('Acesso anônimo', 'codexplus') }}</div>
            {% if not anon.on %}
                <p class="cx-perm-empty">{{ __('Desligado. Quem tiver o link lê o documento sem entrar no GLPI.', 'codexplus') }}</p>
                <button type="submit" form="cx-anon-form" name="anon_generate" value="1" class="codexplus-btn">
                    <i class="ti ti-link"></i> {{ __('Gerar link', 'codexplus') }}
                </button>
            {% else %}
                <div class="cx-anon-url">
                    <input type="text" readonly class="form-control" value="{{ anon.url }}" data-cx-anon-url onclick="this.select();"
                           aria-label="{{ __('Link de acesso anônimo', 'codexplus') }}">
                    <button type="button" class="codexplus-btn" title="{{ __('Copiar', 'codexplus') }}" aria-label="{{ __('Copiar', 'codexplus') }}"
                            onclick="var i=this.parentNode.querySelector('[data-cx-anon-url]');i.select();if(navigator.clipboard){navigator.clipboard.writeText(i.value);}else{document.execCommand('copy');}this.querySelector('i').className='ti ti-check';">
                        <i class="ti ti-copy"></i>
                    </button>
                </div>
                <div class="codexplus-form-hint">
                    {% if anon.date %}{{ __('Gerado em %s', 'codexplus')|format(anon.date|date('d/m/Y')) }}{% if anon.by %} {{ __('por %s', 'codexplus')|format(anon.by) }}{% endif %} · {% endif %}
                    {{- anon.hits == 1 ? __('1 acesso', 'codexplus') : __('%d acessos', 'codexplus')|format(anon.hits) }}
                    {%- if anon.last %}, {{ __('último em %s', 'codexplus')|format(anon.last|date('d/m/Y H:i')) }}{% endif %}
                </div>
                <div class="cx-anon-actions">
                    <button type="submit" form="cx-anon-form" name="anon_generate" value="1" class="codexplus-btn"
                            onclick="return confirm('{{ __('Gerar um link novo? O link atual para de funcionar.', 'codexplus')|e('js') }}');">
                        <i class="ti ti-refresh"></i> {{ __('Gerar novo link', 'codexplus') }}
                    </button>
                    <button type="submit" form="cx-anon-form" name="anon_revoke" value="1" class="codexplus-btn cx-btn-danger-outline"
                            onclick="return confirm('{{ __('Revogar o link? Quem tiver o link deixa de ler o documento.', 'codexplus')|e('js') }}');">
                        <i class="ti ti-link-off"></i> {{ __('Revogar', 'codexplus') }}
                    </button>
                </div>
                <div class="codexplus-form-hint">{{ __('Gerar novo derruba o anterior. Durante uma revisão, o link mostra a versão publicada.', 'codexplus') }}</div>
            {% endif %}
        </div>
    {% endif %}

    {% if perm.can_manage %}
        <div class="cx-perm-msg" data-cxp-msg role="status" aria-live="polite"></div>
        <div class="codexplus-form-hint">
            {% if perm.pending %}
                {{ __('Gravado junto com o rascunho.', 'codexplus') }}
            {% else %}
                {{ __('A mudança vale na hora, sem precisar salvar.', 'codexplus') }}
            {% endif %}
        </div>
    {% endif %}
    <div data-cxp-pending hidden></div>
</aside>
