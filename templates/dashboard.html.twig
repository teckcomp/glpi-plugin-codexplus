{# Codex+ — Painel.
   Etapas 6b/6c (zonas A–E), identidade visual e donuts na 0.6.5.
   0.6.6 (Claudio, 20/09/2026): o Painel lê o MODELO NOVO (Dashboard::
   loadAllNew), antecipando a parte do Painel da R5. Sai o quadro provisório
   da R3b1; entram o indicador "Em revisão" e as colunas Setor e Responsável.
   Indicadores e legendas deixam de ser links até a estante nova existir:
   a tela Documentos ainda lista o modelo antigo.
   Estilos em public/css/codexplus.css (seções 11 e 15). #}

<div class="codexplus-app">

    {% include '@codexplus/parts/brand.html.twig' with {
        title: __('Codex+', 'codexplus'),
        subtitle: __('Documentos controlados, procedimentos e diagramas institucionais', 'codexplus'),
    } only %}

    {# ============ ZONA A — navegação e ação ============ #}
    <nav class="codexplus-nav">
        <a href="dashboard.php" class="is-active">{{ __('Painel', 'codexplus') }}</a>
        <a href="wiki.php">{{ __('Documentos', 'codexplus') }}</a>
        <a href="templates.php">{{ __('Modelos', 'codexplus') }}</a>
    </nav>

    <div class="cx-dash-actionbar">
        <form method="get" action="wiki.php" class="cx-dash-search">
            <i class="ti ti-search"></i>
            <input type="text" name="q"
                   placeholder="{{ __('Buscar por título, código ou conteúdo…', 'codexplus') }}">
        </form>
        {% if can_create %}
            <a href="document.form.php?doctype=DIA" class="cx-btn">
                <i class="ti ti-sitemap"></i> {{ __('Novo diagrama', 'codexplus') }}
            </a>
            <a href="document.form.php" class="cx-btn cx-btn-primary">
                <i class="ti ti-plus"></i> {{ __('Novo documento', 'codexplus') }}
            </a>
        {% endif %}
    </div>

    {# ============ Aguardando você (R3d-1) ============
       Só aparece quando há algo. Mesma regra dos botões da página do
       documento: quem está aqui consegue agir. #}
    {% if pending %}
        <section class="cx-card cx-pending" aria-label="{{ __('Aguardando você', 'codexplus') }}">
            <h3 class="cx-card-title">
                <i class="ti ti-bell-ringing"></i> {{ __('Aguardando você', 'codexplus') }}
                <span class="cx-pending-count">{{ pending|length }}</span>
            </h3>
            <ul class="cx-pending-list">
                {% for p in pending %}
                    <li class="cx-pending-item">
                        <span class="codexplus-code cx-code-chip cx-code-type-{{ p.doctype }}">{{ p.code }}</span>
                        <a class="cx-pending-name" href="{{ form_url }}?id={{ p.id }}">{{ p.name }}</a>
                        <span class="cx-pending-meta">
                            {{ p.etapa }}{% if p.quem %} · {{ p.quem }}{% endif %}{% if p.ago %} · {{ p.ago }}{% endif %}
                            {% if p.bloqueio %}<span class="cx-pending-block"><i class="ti ti-lock"></i> {{ p.bloqueio }}</span>{% endif %}
                        </span>
                        {% if p.acao %}
                            <a class="codexplus-btn codexplus-btn-primary cx-pending-go" href="{{ form_url }}?id={{ p.id }}">
                                <i class="ti ti-circle-check"></i> {{ p.acao }}
                            </a>
                        {% else %}
                            <a class="codexplus-btn cx-pending-go" href="{{ form_url }}?id={{ p.id }}">{{ __('Abrir', 'codexplus') }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if counters.total == 0 %}

        {# ---- Estado vazio: zeros pareceriam defeito. Convida a criar. ---- #}
        <div class="cx-dash-blank">
            <i class="ti ti-book-2"></i>
            <h3>{{ __('Comece seu acervo', 'codexplus') }}</h3>
            <p>{{ __('Crie o primeiro documento. Os indicadores aparecem assim que houver acervo.', 'codexplus') }}</p>
        </div>

    {% else %}

        {# ============ ZONA B — indicadores com contexto ============ #}
        <div class="cx-dash-stats cx-dash-stats--5">

            <div class="cx-stat">
                <div class="cx-stat-head">
                    <span class="cx-stat-chip cx-chip-accent"><i class="ti ti-circle-check"></i></span>
                    <span class="cx-stat-label">{{ __('Publicados', 'codexplus') }}</span>
                </div>
                <div class="cx-stat-value">{{ counters.publicados }}</div>
                <div class="cx-stat-context">
                    {{ __('de', 'codexplus') }} {{ counters.total }} {{ __('documentos', 'codexplus') }}
                </div>
            </div>

            <div class="cx-stat">
                <div class="cx-stat-head">
                    <span class="cx-stat-chip cx-chip-accent"><i class="ti ti-eye-check"></i></span>
                    <span class="cx-stat-label">{{ __('Em revisão', 'codexplus') }}</span>
                </div>
                <div class="cx-stat-value cx-stat-accent">{{ counters.emrevisao }}</div>
                <div class="cx-stat-context">
                    {% if counters.emrevisao > 0 %}
                        {{ __('aguardando validação', 'codexplus') }}
                    {% else %}
                        {{ __('nada aguardando', 'codexplus') }}
                    {% endif %}
                </div>
            </div>

            <div class="cx-stat">
                <div class="cx-stat-head">
                    <span class="cx-stat-chip cx-chip-warn"><i class="ti ti-clock"></i></span>
                    <span class="cx-stat-label">{{ __('A vencer (30 d)', 'codexplus') }}</span>
                </div>
                <div class="cx-stat-value cx-stat-warn">{{ counters.avencer }}</div>
                <div class="cx-stat-context">
                    {% if counters.proximo_dias is not null %}
                        {{ __('o mais próximo em', 'codexplus') }} {{ counters.proximo_dias }} {{ __('dia(s)', 'codexplus') }}
                    {% else %}
                        {{ __('nada vencendo agora', 'codexplus') }}
                    {% endif %}
                </div>
            </div>

            <div class="cx-stat">
                <div class="cx-stat-head">
                    <span class="cx-stat-chip cx-chip-danger"><i class="ti ti-alert-triangle"></i></span>
                    <span class="cx-stat-label">{{ __('Vencidos', 'codexplus') }}</span>
                </div>
                <div class="cx-stat-value cx-stat-danger">{{ counters.vencidos }}</div>
                <div class="cx-stat-context">
                    {% if counters.vencidos_tipo %}
                        {{ counters.vencidos_tipo_n }} {{ __('são', 'codexplus') }} {{ counters.vencidos_tipo }}
                    {% else %}
                        {{ __('tudo em dia', 'codexplus') }}
                    {% endif %}
                </div>
            </div>

            <div class="cx-stat">
                <div class="cx-stat-head">
                    <span class="cx-stat-chip cx-chip-neutral"><i class="ti ti-pencil"></i></span>
                    <span class="cx-stat-label">{{ __('Rascunhos', 'codexplus') }}</span>
                </div>
                <div class="cx-stat-value cx-stat-neutral">{{ counters.rascunhos }}</div>
                <div class="cx-stat-context">
                    {% if counters.rascunhos_parados > 0 %}
                        {{ counters.rascunhos_parados }} {{ __('parado(s) há 30 dias', 'codexplus') }}
                    {% else %}
                        {{ __('nenhum parado', 'codexplus') }}
                    {% endif %}
                </div>
            </div>

        </div>

        {# ============ ZONA C — donuts + atenção ============ #}
        <div class="cx-dash-cards">

            {# ---- Por tipo. O anel é um conic-gradient com as cores dos tokens
                 --cx-type-*; fatias em % acumulada. ---- #}
            {% set type_total = 0 %}
            {% for t in by_type %}{% set type_total = type_total + t.total %}{% endfor %}
            {% set acc = 0 %}
            {% set stops = [] %}
            {% for t in by_type %}
                {% if t.total > 0 and type_total > 0 %}
                    {% set start = acc %}
                    {% set acc = acc + (t.total / type_total * 100) %}
                    {% set stops = stops|merge(['var(--cx-type-' ~ t.key ~ ') ' ~ start|round(2) ~ '% ' ~ acc|round(2) ~ '%']) %}
                {% endif %}
            {% endfor %}
            <section class="cx-card">
                <h3 class="cx-card-title">{{ __('Por tipo', 'codexplus') }}</h3>
                <div class="cx-donut-card">
                    <div class="cx-donut"{% if stops is not empty %} style="background: conic-gradient({{ stops|join(', ') }});"{% endif %}>
                        <div class="cx-donut-center">
                            <span class="cx-donut-value">{{ type_total }}</span>
                            <span class="cx-donut-label">{{ __('documentos', 'codexplus') }}</span>
                        </div>
                    </div>
                    <ul class="cx-legend">
                        {% for t in by_type %}
                            <li>
                                <span class="cx-legend-row">
                                    <span class="cx-legend-dot cx-dot-{{ t.key }}"></span>
                                    <span class="cx-legend-name">{{ t.name }}</span>
                                    <span class="cx-legend-total">{{ t.total }}</span>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>

            {# ---- Situação. "Em dia" = publicado que não está a vencer nem
                 vencido (inclui proposta, que não vence); "Em revisão" =
                 aguardando validação; "Outros" = obsoleto, só se houver. ---- #}
            {% set sit_emdia = max(0, counters.publicados - counters.avencer - counters.vencidos) %}
            {% set sit_outros = max(0, counters.total - counters.publicados - counters.rascunhos - counters.emrevisao) %}
            {% set situacoes = [
                {key: 'emdia',     name: __('Em dia', 'codexplus'),     n: sit_emdia,          color: 'var(--cx-ok)'},
                {key: 'avencer',   name: __('A vencer', 'codexplus'),   n: counters.avencer,   color: 'var(--cx-warn-mark)'},
                {key: 'vencido',   name: __('Vencido', 'codexplus'),    n: counters.vencidos,  color: 'var(--cx-danger)'},
                {key: 'emrevisao', name: __('Em revisão', 'codexplus'), n: counters.emrevisao, color: 'var(--cx-accent)'},
                {key: 'rascunho',  name: __('Rascunho', 'codexplus'),   n: counters.rascunhos, color: 'var(--cx-faint)'},
                {key: 'outros',    name: __('Obsoleto', 'codexplus'),   n: sit_outros,         color: 'var(--cx-border)'},
            ] %}
            {% set acc = 0 %}
            {% set stops = [] %}
            {% for s in situacoes %}
                {% if s.n > 0 and counters.total > 0 %}
                    {% set start = acc %}
                    {% set acc = acc + (s.n / counters.total * 100) %}
                    {% set stops = stops|merge([s.color ~ ' ' ~ start|round(2) ~ '% ' ~ acc|round(2) ~ '%']) %}
                {% endif %}
            {% endfor %}
            <section class="cx-card">
                <h3 class="cx-card-title">{{ __('Situação', 'codexplus') }}</h3>
                <div class="cx-donut-card">
                    <div class="cx-donut"{% if stops is not empty %} style="background: conic-gradient({{ stops|join(', ') }});"{% endif %}>
                        <div class="cx-donut-center">
                            <span class="cx-donut-value">{{ counters.total > 0 ? (counters.publicados / counters.total * 100)|round : 0 }}%</span>
                            <span class="cx-donut-label">{{ __('publicado', 'codexplus') }}</span>
                        </div>
                    </div>
                    <ul class="cx-legend">
                        {% for s in situacoes %}
                            {% if s.key != 'outros' or s.n > 0 %}
                                <li>
                                    <span class="cx-legend-row">
                                        <span class="cx-legend-dot cx-dot-{{ s.key }}"></span>
                                        <span class="cx-legend-name">{{ s.name }}</span>
                                        <span class="cx-legend-total">{{ s.n }}</span>
                                    </span>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            </section>

            <section class="cx-card">
                <h3 class="cx-card-title">{{ __('Precisa de atenção', 'codexplus') }}</h3>
                <ul class="cx-card-list">
                    <li>
                        <span>
                            <i class="ti ti-alert-triangle cx-ico-danger"></i>
                            <span class="cx-card-item-name">{{ __('Revisão vencida', 'codexplus') }}</span>
                            <span class="cx-card-item-count cx-count-danger">{{ attention.revisao_vencida }}</span>
                        </span>
                    </li>
                    <li>
                        <span>
                            <i class="ti ti-folder-off cx-ico-warn"></i>
                            <span class="cx-card-item-name">{{ __('Sem categoria', 'codexplus') }}</span>
                            <span class="cx-card-item-count cx-count-warn">{{ attention.sem_categoria }}</span>
                        </span>
                    </li>
                    <li>
                        <span>
                            <i class="ti ti-user-off cx-ico-warn"></i>
                            <span class="cx-card-item-name">{{ __('Sem responsável', 'codexplus') }}</span>
                            <span class="cx-card-item-count cx-count-warn">{{ attention.sem_responsavel }}</span>
                        </span>
                    </li>
                    <li class="is-disabled"
                        title="{{ __('Disponível a partir da Etapa 5 (relação PSG → POPs)', 'codexplus') }}">
                        <span>
                            <i class="ti ti-unlink"></i>
                            <span class="cx-card-item-name">{{ __('PSG sem POP vinculado', 'codexplus') }}</span>
                            <span class="cx-count-soon">{{ __('etapa 5', 'codexplus') }}</span>
                        </span>
                    </li>
                </ul>
            </section>

        </div>

        {# ============ Diagramas (Etapa 9, 0.6.7) ============ #}
        <section class="cx-card cx-card-wide">
            <h3 class="cx-card-title"><i class="ti ti-sitemap"></i> {{ __('Diagramas', 'codexplus') }}</h3>
            {% if diagrams is not empty %}
                <div class="cx-diagram-grid">
                    {% for d in diagrams %}
                        <a class="cx-diagram-tile" href="document.form.php?id={{ d.id }}">
                            <span class="cx-diagram-mini" aria-hidden="true">
                                <i style="--lc: var(--cx-l-diretoria)"></i>
                                <span><i style="--lc: var(--cx-l-gestao)"></i><i style="--lc: var(--cx-l-gestao)"></i></span>
                                <span><i style="--lc: var(--cx-l-supervisao)"></i><i style="--lc: var(--cx-l-n2)"></i><i style="--lc: var(--cx-l-n1)"></i></span>
                            </span>
                            <span class="cx-diagram-meta">
                                <span class="codexplus-code cx-code-chip cx-code-type-DIA">{{ d.code }}</span>
                                <span class="cx-diagram-name">{{ d.name }}</span>
                            </span>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="codexplus-muted">{{ __('Nenhum diagrama ainda. Use "Novo diagrama" para criar o primeiro organograma.', 'codexplus') }}</p>
            {% endif %}
        </section>

        {# ============ ZONA D — atualizados recentemente (tabela) ============ #}
        <section class="cx-card cx-card-wide">
            <h3 class="cx-card-title">{{ __('Atualizados recentemente', 'codexplus') }}</h3>

            <table class="codexplus-table cx-recent-table cx-recent-table--new">
                <thead>
                    <tr>
                        <th>{{ __('Código', 'codexplus') }}</th>
                        <th>{{ __('Documento', 'codexplus') }}</th>
                        <th>{{ __('Categoria', 'codexplus') }}</th>
                        <th>{{ __('Setor', 'codexplus') }}</th>
                        <th>{{ __('Responsável', 'codexplus') }}</th>
                        <th>{{ __('Quando', 'codexplus') }}</th>
                        <th>{{ __('Situação', 'codexplus') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for d in recent %}
                        <tr>
                            <td><span class="codexplus-code cx-code-chip cx-code-type-{{ d.doctype }}">{{ d.code }}</span></td>
                            <td class="cx-cell-clip">
                                <a class="codexplus-doc-link" href="document.form.php?id={{ d.id }}">{{ d.name }}</a>
                            </td>
                            <td class="cx-cell-clip" title="{{ d.category }}">
                                {% if d.category %}{{ d.category }}{% else %}<span class="codexplus-muted">—</span>{% endif %}
                            </td>
                            <td class="cx-cell-clip">
                                {% if d.sector %}{{ d.sector }}{% else %}<span class="codexplus-muted">—</span>{% endif %}
                            </td>
                            <td class="cx-cell-clip">
                                {% if d.owner %}{{ d.owner }}{% else %}<span class="codexplus-muted">—</span>{% endif %}
                            </td>
                            <td class="cx-cell-when">{{ d.ago }}</td>
                            <td>
                                {% if d.status == 'aprovacao' %}
                                    <span class="codexplus-status codexplus-status--aprovacao">{{ __('aguarda gestor', 'codexplus') }}</span>
                                {% elseif d.status == 'validacao' %}
                                    <span class="codexplus-status codexplus-status--validacao">{{ __('aguarda auditor', 'codexplus') }}</span>
                                {% elseif d.status == 'rascunho' %}
                                    <span class="codexplus-status codexplus-status--rascunho">{{ __('rascunho', 'codexplus') }}</span>
                                {% elseif d.status == 'obsoleto' %}
                                    <span class="codexplus-status codexplus-status--obsoleto">{{ __('obsoleto', 'codexplus') }}</span>
                                {% elseif d.expiry == 'vencido' %}
                                    <span class="codexplus-status codexplus-status--vencido">{{ __('vencido', 'codexplus') }}</span>
                                {% elseif d.expiry == 'avencer' %}
                                    <span class="codexplus-status codexplus-status--avencer">{{ __('a vencer', 'codexplus') }}</span>
                                {% elseif d.expiry == 'emdia' %}
                                    <span class="codexplus-status codexplus-status--emdia">{{ __('em dia', 'codexplus') }}</span>
                                {% else %}
                                    <span class="codexplus-status codexplus-status--publicado">{{ __('publicado', 'codexplus') }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

    {% endif %}

</div>
