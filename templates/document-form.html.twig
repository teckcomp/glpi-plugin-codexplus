{# Codex+ — Etapa R3b1: página do documento no modelo novo.
   Criar, editar (só rascunho: responsável, revisor, autor) e mover no fluxo
   (Enviar, Validar, Devolver, Obsoleto). Regras em src/Document.php;
   aqui só se mostra o que o controller liberou.
   Estilos: public/css/codexplus.css, seção 14. #}

{# 22/09/2026 (Claudio): na criação e na edição a página usa a largura da
   tela (até 1320px); a visão de leitura continua na moldura de folha.
   04/10/2026 (Claudio): cronograma e matriz RACI saem em PDF paisagem, então
   a leitura deles usa a folha deitada (mesma largura da edição). #}
<div class="codexplus-app{{ can_edit ? ' cx-docpage--wide' : (is_diagram and diagram_kind in ['cronograma', 'raci'] ? ' cx-docpage--paisagem' : '') }}">

    <div class="codexplus-article-bar">
        <a href="{{ glpi_root }}/plugins/codexplus/front/dashboard.php" class="codexplus-back">
            <i class="ti ti-arrow-left"></i> {{ __('Codex+', 'codexplus') }}
        </a>
        {% if not is_new %}
            <div class="cx-docform-ident">
                <span class="codexplus-code cx-code-chip">{{ code }}</span>
                <span class="codexplus-muted">{{ doctype_label }}</span>
                <span class="codexplus-status codexplus-status--{{ status }}">{{ status_label }}</span>
                {% if can_duplicate %}
                    {# R3b2-b parte 2: documento novo, código novo. Fora do
                       formulário de edição: copia o que está gravado. #}
                    <form method="post" action="{{ self }}" class="cx-docform-dup">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="id" value="{{ id }}">
                        <button type="submit" name="duplicate" value="1" class="codexplus-btn"
                                title="{{ __('Cria um documento novo, com código novo, a partir deste', 'codexplus') }}"
                                onclick="return confirm('{{ __('Criar um documento NOVO, com código novo, a partir deste? A cópia leva título, categorias e conteúdo como estão gravados (o que não foi salvo fica de fora), e nasce em rascunho sem auditor, revisor nem permissões.', 'codexplus')|e('js') }}');">
                            <i class="ti ti-copy"></i> {{ __('Duplicar', 'codexplus') }}
                        </button>
                    </form>
                    {% if dup_types is not empty %}
                        {# T3 (Claudio, 27/09/2026): "Duplicar como" abre um menu
                           com os outros tipos; cada item cria o documento novo
                           naquele tipo. Diagrama não tem o botão. #}
                        <div class="cx-dup-as">
                            <button type="button" class="codexplus-btn" data-cx-dup-toggle aria-haspopup="true" aria-expanded="false"
                                    title="{{ __('Cria um documento novo de outro tipo a partir deste; este não muda', 'codexplus') }}">
                                <i class="ti ti-transform"></i> {{ __('Duplicar como', 'codexplus') }} <i class="ti ti-chevron-down"></i>
                            </button>
                            <form method="post" action="{{ self }}" class="cx-dup-menu" data-cx-dup-menu hidden>
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="id" value="{{ id }}">
                                <input type="hidden" name="duplicate" value="1">
                                <p class="cx-dup-menu-hint">{{ __('Documento novo, no tipo escolhido, com o código, o fluxo e a validade dele. Este não muda.', 'codexplus') }}</p>
                                {% for key, label in dup_types %}
                                    {% if key != doctype %}
                                        <button type="submit" name="duplicate_type" value="{{ key }}" class="cx-dup-item"
                                                onclick="return confirm('{{ __('Criar um documento NOVO como %s a partir deste? Ele leva título, categorias e conteúdo como estão gravados e nasce em rascunho sem auditor, revisor nem permissões. Este documento não muda.', 'codexplus')|format(label)|e('js') }}');">{{ label }}</button>
                                    {% endif %}
                                {% endfor %}
                            </form>
                        </div>
                        <script>
                        (function () {
                            var box = document.currentScript && document.currentScript.previousElementSibling;
                            if (!box || !box.classList.contains('cx-dup-as')) { return; }
                            var btn = box.querySelector('[data-cx-dup-toggle]');
                            var menu = box.querySelector('[data-cx-dup-menu]');
                            var set = function (open) { menu.hidden = !open; btn.setAttribute('aria-expanded', open ? 'true' : 'false'); };
                            btn.addEventListener('click', function () { set(menu.hidden); });
                            document.addEventListener('click', function (e) { if (!menu.hidden && !box.contains(e.target)) { set(false); } });
                            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
                        })();
                        </script>
                    {% endif %}
                {% endif %}
                {% if can_delete %}
                    {# R5: vai para a lixeira; restaurar na Biblioteca. #}
                    <form method="post" action="{{ self }}" class="cx-docform-dup">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="id" value="{{ id }}">
                        <button type="submit" name="delete_doc" value="1" class="codexplus-btn cx-btn-danger-outline"
                                onclick="return confirm('{{ __('Mandar este documento para a lixeira? Dá para restaurar depois, na Biblioteca.', 'codexplus')|e('js') }}');">
                            <i class="ti ti-trash"></i> {{ __('Excluir', 'codexplus') }}
                        </button>
                    </form>
                {% endif %}
                {% if can_save_template %}
                    {# M1: o corpo gravado vira modelo do mesmo tipo. #}
                    <form method="post" action="{{ self }}" class="cx-docform-dup">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="id" value="{{ id }}">
                        <input type="hidden" name="tpl_name" value="">
                        <button type="submit" name="save_template" value="1" class="codexplus-btn"
                                title="{{ __('Cria um modelo a partir do corpo gravado deste documento', 'codexplus') }}"
                                onclick="var n = prompt('{{ __('Nome do modelo (o corpo gravado vira um modelo deste tipo; imagens não vão):', 'codexplus')|e('js') }}', '{{ name|e('js') }}'); if (!n) { return false; } this.form.tpl_name.value = n;">
                            <i class="ti ti-template"></i> {{ __('Salvar como modelo', 'codexplus') }}
                        </button>
                    </form>
                {% endif %}
            </div>
            {# R3b3-2: ler e exportar (texto; o diagrama tem PDF no próprio motor). #}
            <div class="codexplus-actions">
                {% if can_edit %}
                    {# D1: também no diagrama (o PDF dele fica no próprio motor). #}
                    <a href="{{ view_link }}" class="codexplus-btn"
                       title="{{ __('Como o documento fica para quem lê, com Exportar PDF. Mostra o que está salvo.', 'codexplus') }}">
                        <i class="ti ti-eye"></i> {{ __('Visualizar e PDF', 'codexplus') }}
                    </a>
                {% else %}
                    {% if can_edit_doc and not version.on %}
                        <a href="{{ edit_link }}" class="codexplus-btn">
                            <i class="ti ti-pencil"></i> {{ __('Editar', 'codexplus') }}
                        </a>
                    {% endif %}
                    {% if is_diagram %}
                        {# D1-4: o PDF do diagrama é o do próprio motor (grade ou
                           organograma); este botão só o aciona, no mesmo lugar
                           do Exportar PDF dos documentos de texto. #}
                        <button type="button" class="codexplus-btn codexplus-btn-primary"
                                onclick="var b = document.querySelector('#codexplus-doc [data-cx-grid] [data-act=pdf], #codexplus-doc [data-cx-orgview] [data-act=pdf], #codexplus-doc [data-cx-flow] [data-act=pdf]'); if (b) { b.click(); }">
                            <i class="ti ti-file-type-pdf"></i> {{ __('Exportar PDF', 'codexplus') }}
                        </button>
                    {% endif %}
                    {% if not is_diagram %}
                        {# E3: Word, com a mesma configuração do PDF (codexplus-export.js). #}
                        <button type="button" class="codexplus-btn" id="codexplus-docx"
                                title="{{ __('Baixa o documento em Word (.docx), para editar ou enviar fora do GLPI', 'codexplus') }}">
                            <i class="ti ti-file-type-docx"></i> {{ __('Exportar Word', 'codexplus') }}
                        </button>
                        {% if composite_url %}
                            {# 5d: PDF com os documentos vinculados, em cascata. #}
                            <button type="button" class="codexplus-btn" id="codexplus-pdf-full" data-url="{{ composite_url }}"
                                    title="{{ __('Este documento e todos os vinculados, em cascata, com sumário (versão publicada de cada um)', 'codexplus') }}">
                                <i class="ti ti-files"></i> {{ __('PDF completo', 'codexplus') }}
                            </button>
                        {% endif %}
                        <button type="button" class="codexplus-btn codexplus-btn-primary" id="codexplus-pdf">
                            <i class="ti ti-file-type-pdf"></i> {{ __('Exportar PDF', 'codexplus') }}
                        </button>
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}
    </div>

    {# ---------------- Revisão de publicado (R6-a) ---------------- #}
    {% if version.on %}
        <div class="cx-notice cx-notice--warn">
            <i class="ti ti-refresh-alert"></i>
            <div>
                {% if version.reader %}
                    <strong>{{ __('Em atualização', 'codexplus') }}</strong> —
                    {{ __('este documento está sendo revisado. Esta é a versão publicada em vigor, %s, válida até a nova ser validada.', 'codexplus')|format(version.code) }}
                {% else %}
                    <strong>{{ __('Versão publicada %s', 'codexplus')|format(version.code) }}</strong> —
                    {{ __('é o que os leitores veem enquanto a revisão não é validada.', 'codexplus') }}
                    <div class="cx-notice-actions">
                        <a href="{{ version.link }}" class="codexplus-btn codexplus-btn-primary">
                            <i class="ti ti-pencil"></i> {{ __('Voltar para a revisão em andamento', 'codexplus') }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
    {% if revinfo.on and revdue is not null and revdue.state == 'atrasada' %}
        {# R6-b: revisão fora do prazo — só para quem tem papel (o leitor vê "Em atualização"). #}
        <div class="cx-notice cx-notice--danger">
            <i class="ti ti-clock-exclamation"></i>
            <div>
                <strong>{{ __('Revisão atrasada', 'codexplus') }}</strong> —
                {{ __('o prazo era %s (%d dia(s) de atraso).', 'codexplus')|format(revdue.due|date('d/m/Y'), revdue.days) }}
                {% if rev_opened %}{{ __('Aberta em %s por %s.', 'codexplus')|format(rev_opened.date|date('d/m/Y'), rev_opened.user) }}{% endif %}
            </div>
        </div>
    {% endif %}
    {% if revinfo.on %}
        <div class="cx-notice">
            <i class="ti ti-refresh"></i>
            <div>
                <strong>{{ __('Revisão %s em andamento.', 'codexplus')|format(code) }}</strong>
                {{ __('Os leitores continuam vendo a versão publicada %s até esta ser validada.', 'codexplus')|format(revinfo.prev_code) }}
                {# R6-b: prazo da revisão (a faixa de atraso fica acima). #}
                {% if revdue is not null and revdue.state == 'no_prazo' %}
                    <div class="cx-revdue">
                        <i class="ti ti-clock"></i>
                        {{ __('Prazo da revisão: %s', 'codexplus')|format(revdue.due|date('d/m/Y')) }}
                        ({{ revdue.days == 0 ? __('vence hoje', 'codexplus') : (revdue.days == 1 ? __('falta 1 dia', 'codexplus') : __('faltam %d dias', 'codexplus')|format(revdue.days)) }})
                    </div>
                {% elseif revdue is not null and revdue.state == 'sem_prazo' %}
                    <div class="cx-revdue">
                        <i class="ti ti-clock"></i>
                        {{ __('Revisão sem prazo (aberta antes do controle de prazo). O responsável define em "Prorrogar prazo".', 'codexplus') }}
                    </div>
                {% endif %}
                {% if rev_extensions is not empty %}
                    <div class="cx-revdue cx-revdue--log">
                        <strong>{{ __('Prorrogações', 'codexplus') }}:</strong>
                        {% for e in rev_extensions %}
                            <div>{{ e.date|date('d/m/Y') }} → {{ e.due|date('d/m/Y') }} · {{ e.user }} · {{ e.reason }}</div>
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="cx-notice-actions">
                    <a href="{{ revinfo.link }}" class="codexplus-btn">
                        <i class="ti ti-eye"></i> {{ __('Ver a versão publicada %s', 'codexplus')|format(revinfo.prev_code) }}
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    {# 5c: vinculado obsoleto ou vencido — cabe revisão deste documento. #}
    {% if link_problems is not empty %}
        <div class="cx-notice cx-notice--warn">
            <i class="ti ti-link-off"></i>
            <div>
                <strong>{{ __('Documento vinculado precisa de atenção', 'codexplus') }}</strong> —
                {% for p in link_problems %}{{ loop.first ? '' : ', ' }}<a href="?id={{ p.id }}">{{ p.code }}</a> {{ p.name }} ({{ p.state == 'obsoleto' ? __('obsoleto', 'codexplus') : __('vencido', 'codexplus') }}){% endfor %}.
                {{ __('Cabe revisar este documento: trocar a referência ou desvincular.', 'codexplus') }}
            </div>
        </div>
    {% endif %}
    {# 5c: de quais documentos este faz parte. #}
    {% if part_of is not empty %}
        <div class="cx-partof">
            <i class="ti ti-hierarchy-2"></i> <span>{{ __('Faz parte de', 'codexplus') }}:</span>
            {% for p in part_of %}
                {%- if not loop.first %} · {% endif -%}
                {% if p.can_view %}<a href="?id={{ p.id }}"><span class="cx-link-code">{{ p.code }}</span> {{ p.name }}</a>
                {% else %}<span class="cx-link-code">{{ p.code }}</span> {{ p.name }} <em>({{ __('sem acesso', 'codexplus') }})</em>{% endif %}
            {% endfor %}
        </div>
    {% endif %}

    {# ---------------- Avisos do fluxo ---------------- #}
    {% if not is_new and not version.on and status == 'rascunho' and validation_comment %}
        <div class="cx-notice cx-notice--warn">
            <i class="ti ti-arrow-back-up"></i>
            <div>
                <strong>{{ __('Devolvido pela validação', 'codexplus') }}</strong>
                {% if validator_name %}— {{ validator_name }}{% endif %}
                {%- if date_validated %}, {{ date_validated|date('d/m/Y H:i') }}{% endif %}
                <div class="cx-notice-text">{{ validation_comment }}</div>
            </div>
        </div>
    {% elseif not is_new and not version.on and validation_comment %}
        {# P1: observação deixada na aprovação (responsável) ou na auditoria. #}
        <div class="cx-notice">
            <i class="ti ti-message-circle"></i>
            <div>
                <strong>{{ status == 'validacao' ? __('Observação do responsável', 'codexplus') : __('Observação da auditoria', 'codexplus') }}</strong>
                <div class="cx-notice-text">{{ validation_comment }}</div>
            </div>
        </div>
    {% endif %}
    {% if validation_block %}
        <div class="cx-notice">
            <i class="ti ti-user-exclamation"></i>
            <div>{{ validation_block }}</div>
        </div>
    {% endif %}
    {% if missing_right and not version.on %}
        <div class="cx-notice cx-notice--warn">
            <i class="ti ti-lock"></i>
            <div>{{ missing_right }}</div>
        </div>
    {% endif %}
    {% if pending.label and not version.on %}
        {# R3d: quem responde pela etapa em que o documento está. #}
        <div class="cx-notice">
            <i class="ti ti-hourglass"></i>
            <div>
                <strong>{{ pending.label }}:</strong>
                {{ pending.names ? pending.names|join(', ') : __('ninguém cadastrado ainda', 'codexplus') }}
                <div class="cx-notice-text">{{ __('Nenhuma alteração no conteúdo até a validação terminar ou o documento ser devolvido.', 'codexplus') }}</div>
            </div>
        </div>
    {% endif %}

    {% if can_edit %}
        {# ================= EDIÇÃO / CRIAÇÃO ================= #}
        <form method="post" action="{{ self }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            {% if not is_new %}<input type="hidden" name="id" value="{{ id }}">{% endif %}

            <article class="codexplus-doc codexplus-doc-edit">

                <div class="codexplus-doc-edit-zone">
                    <label class="codexplus-doc-edit-zone-label" for="cx-docform-name">
                        <i class="ti ti-heading"></i> {{ __('Título', 'codexplus') }}
                    </label>
                    <input type="text" id="cx-docform-name" name="name" value="{{ name }}"
                           class="form-control cx-docform-title" required
                           placeholder="{{ __('Título do documento', 'codexplus') }}">
                </div>

                {# Dados do documento recolhíveis, em três abas (Claudio,
                   04/10/2026). Só tela: os campos continuam neste formulário e
                   são gravados juntos. public/js/codexplus-meta.js. #}
                <div class="cx-meta" data-cx-meta data-new="{{ meta.new ? '1' : '0' }}" data-missing="{{ meta.missing ? '1' : '0' }}" data-missing-tab="{{ meta.no_place|default(false) ? 'lugar' : 'pessoas' }}">
                    <div class="cx-meta-bar">
                        <i class="ti ti-info-square-rounded cx-meta-ico"></i>
                        {% if meta.new %}
                            <span class="cx-meta-item">{{ __('Dados do documento', 'codexplus') }}</span>
                        {% else %}
                            <span class="cx-meta-item"><span>{{ __('Estante', 'codexplus') }}</span>
                                {% if meta.no_place %}<b class="is-missing">{{ __('falta', 'codexplus') }}</b>{% else %}{{ meta.estante }}{% endif %}</span>
                            <span class="cx-meta-item"><span>{{ __('Responsável', 'codexplus') }}</span> {{ meta.owner ?: '—' }}</span>
                            {% if meta.auditor is not same as(false) %}
                                <span class="cx-meta-item"><span>{{ __('Auditor', 'codexplus') }}</span>
                                    {% if meta.auditor is null %}<b class="is-missing">{{ __('falta', 'codexplus') }}</b>{% else %}{{ meta.auditor }}{% endif %}</span>
                            {% endif %}
                            {% if perm.show %}
                                <span class="cx-meta-item"><span>{{ __('Leitura', 'codexplus') }}</span>
                                    {{ meta.read_all|default(false) ? __('todos', 'codexplus') : (meta.readers == 0 ? __('só quem tem papel', 'codexplus') : (meta.readers == 1 ? __('1 alvo', 'codexplus') : __('%d alvos', 'codexplus')|format(meta.readers))) }}</span>
                            {% endif %}
                            {% if meta.brand %}<span class="cx-meta-item"><span>{{ __('Marca', 'codexplus') }}</span> {{ meta.brand }}</span>{% endif %}
                        {% endif %}
                        <button type="button" class="codexplus-btn cx-meta-toggle" data-cx-meta-toggle aria-expanded="true">
                            <i class="ti ti-chevron-up"></i> {{ __('Ocultar dados', 'codexplus') }}
                        </button>
                    </div>
                    <div class="cx-meta-tabs" role="tablist">
                        <button type="button" role="tab" class="cx-meta-tab" data-cx-tab-btn="lugar">{{ __('Lugar e tipo', 'codexplus') }}</button>
                        <button type="button" role="tab" class="cx-meta-tab" data-cx-tab-btn="pessoas">{{ __('Pessoas e revisão', 'codexplus') }}</button>
                        {% if perm.show %}<button type="button" role="tab" class="cx-meta-tab" data-cx-tab-btn="perm">{{ __('Permissões e link', 'codexplus') }}</button>{% endif %}
                        {% if history.show %}<button type="button" role="tab" class="cx-meta-tab" data-cx-tab-btn="historico"><i class="ti ti-history"></i> {{ __('Histórico', 'codexplus') }}</button>{% endif %}
                    </div>
                {# R3b2-a: campos à esquerda, coluna "Permissões" à direita. #}
                <div class="codexplus-doc-edit-zone cx-docform-split{{ perm.show ? ' cx-docform-split--perm' : '' }}">
                <div class="cx-docform-grid">
                    {% if is_new %}
                        <div class="cx-docform-field" data-cx-tab="lugar">
                            <label>{{ __('Tipo', 'codexplus') }}</label>
                            {{ widgets.doctype|raw }}
                            <div class="codexplus-form-hint">{{ __('O tipo forma o código e não muda depois.', 'codexplus') }}</div>
                        </div>
                        <div class="cx-docform-field" data-cx-tab="lugar" data-cx-only-type="{{ template_types }}">
                            {# R3b4: modelo do tipo escolhido; preenche o corpo
                               (public/js/codexplus-docform.js). Busca a partir de
                               10 modelos. #}
                            <label for="cx-template">{{ __('Modelo', 'codexplus') }}</label>
                            <select id="cx-template" class="form-select" aria-label="{{ __('Modelo', 'codexplus') }}"></select>
                            <script type="application/json" id="cx-templates-data">{{ templates_json|raw }}</script>
                            <div class="codexplus-form-hint">{{ __('Preenche o corpo ao criar. Dá para apagar ou mudar tudo depois.', 'codexplus') }}</div>
                        </div>
                        <div class="cx-docform-field" data-cx-tab="lugar" data-cx-only-type="DIA">
                            <label>{{ __('Subtipo do diagrama', 'codexplus') }}</label>
                            {{ widgets.subtype|raw }}
                            <div class="codexplus-form-hint">{{ __('Organograma, cronograma, matriz RACI ou fluxograma. Não muda depois.', 'codexplus') }}</div>
                        </div>
                    {% endif %}

                    {# SC1: Setor / Categorias (parts/doc-placement). #}
                    <div class="cx-docform-field cx-docform-field--wide" data-cx-tab="lugar">
                        {% include '@codexplus/parts/doc-placement.html.twig' with {placement: placement, category_names: category_names} only %}
                    </div>

                    {% if widgets.owner is defined %}
                        <div class="cx-docform-field" data-cx-tab="pessoas">
                            <label>{{ __('Responsável', 'codexplus') }}</label>
                            {{ widgets.owner|raw }}
                            <div class="codexplus-form-hint">{{ __('Gestor do documento: aprova a 1ª etapa, edita e recebe o aviso de vencimento. Aparece quem tem Ler no Codex+.', 'codexplus') }}</div>
                        </div>
                    {% endif %}

                    {% if review.show %}
                        <div class="cx-meta-group" data-cx-tab="pessoas">
                        {% include '@codexplus/parts/doc-review.html.twig' with {review: review} only %}
                        </div>
                    {% endif %}

                    {% if is_new or doctype == 'PRP' %}
                        {# Só em proposta. Na criação o tipo ainda pode mudar: o
                           campo aparece quando o tipo escolhido é PRP
                           (public/js/codexplus-docform.js). #}
                        <div class="cx-docform-field" data-cx-tab="lugar" data-cx-only-type="PRP" {% if is_new %}hidden{% endif %}>
                            <label for="cx-docform-client">{{ __('Cliente', 'codexplus') }}</label>
                            <input type="text" id="cx-docform-client" name="client_name" value="{{ client_name }}" class="form-control">
                            <div class="codexplus-form-hint">{{ __('A quem a proposta se destina. Sai na identificação do documento e no PDF.', 'codexplus') }}</div>
                        </div>
                    {% endif %}

                    {% if widgets.client is defined %}
                        {# Bloco T1: Laudo e Documentação Técnica, cliente
                           vinculado a um usuário ou entidade do GLPI (a
                           configuração do Codex+ diz qual). Na criação aparece
                           com o tipo (public/js/codexplus-docform.js). #}
                        <div class="cx-docform-field" data-cx-tab="lugar" data-cx-only-type="LAU DTC" {% if is_new %}hidden{% endif %}>
                            <label>{{ __('Cliente', 'codexplus') }} <span class="codexplus-muted">({{ client.source_label }})</span></label>
                            <input type="hidden" name="client_itemtype" value="{{ client.itemtype }}">
                            {{ widgets.client|raw }}
                            <div class="codexplus-form-hint">{{ __('Sai na identificação do documento e no PDF. Não dá acesso ao documento: quem lê continua na coluna Permissões.', 'codexplus') }}</div>
                        </div>
                    {% endif %}

                    {% if brand.show %}
                        {# M-2 (Claudio, 04/10/2026): de qual marca é o documento —
                           logo, nome e cor do PDF e do Word. Só com mais de uma
                           marca; na criação, some no DIA (codexplus-docform.js). #}
                        {% set brand_sel = brand.options|filter(b => b.id == brand.id)|first %}
                        <div class="cx-docform-field" data-cx-tab="lugar" {% if is_new %}data-cx-only-type="{{ brand.types }}" hidden{% endif %}>
                            <label for="cx-docform-brand">{{ __('Marca', 'codexplus') }}</label>
                            <div class="cx-docbrand">
                                <span class="cx-docbrand-logo"><img data-cx-brand-logo src="{{ brand_sel ? brand_sel.logo : '' }}" alt="" {% if not brand_sel or not brand_sel.logo %}hidden{% endif %}></span>
                                <select id="cx-docform-brand" name="plugin_codexplus_brands_id" class="form-select" data-cx-brand-select>
                                    {% for b in brand.options %}
                                        <option value="{{ b.id }}" data-logo="{{ b.logo }}" {{ b.id == brand.id ? 'selected' : '' }}>{{ b.name }}{{ b.is_default ? ' — ' ~ __('padrão', 'codexplus') : '' }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="codexplus-form-hint">{{ __('Logo, nome e cor que saem no PDF e no Word. Muda só em rascunho.', 'codexplus') }}</div>
                        </div>
                    {% endif %}
                </div>
                {% if perm.show %}
                    <div data-cx-tab="perm">
                    {% include '@codexplus/parts/doc-permissions.html.twig' with {perm: perm, id: id, csrf_token: csrf_token, anon: anon} only %}
                    </div>
                {% endif %}
                {# HV-1: 4ª aba. #}
                {% if history.show %}
                    <div data-cx-tab="historico">
                    {% include '@codexplus/parts/doc-history.html.twig' with {history: history} only %}
                    </div>
                {% endif %}
                </div>
                </div>{# /cx-meta #}

                {% if is_diagram and diagram_kind == 'fluxograma' %}
                    {# Q5a: fluxograma no motor de quadro (codexplus-board.js), aberto
                       pelo codexplus-flow.js. Salvar do quadro grava por AJAX; o
                       hidden _diagram acompanha, para o Salvar do formulário não
                       apagar nada (conteúdo igual não conta como alteração). #}
                    <div class="codexplus-doc-edit-zone cx-docform-diagram">
                        <label class="codexplus-doc-edit-zone-label">
                            <i class="ti ti-hierarchy-3"></i> {{ diagram_kind_label }}
                        </label>
                        <script type="application/json" id="cx-flow-data">{{ diagram_json|raw }}</script>
                        <input type="hidden" name="_diagram" id="cx-flow-input" value="{{ diagram_json }}">
                        <div data-cx-flow data-editable="1" data-sign="{{ signers_line|default('') ? __('Aprovadores', 'codexplus') ~ ': ' ~ signers_line : '' }}" data-source="cx-flow-data" data-input="cx-flow-input"
                             data-title="{{ name }}" data-code="{{ code }}"
                             data-doc="{{ id }}" data-save="{{ glpi_root }}/plugins/codexplus/ajax/diagram.save.php"></div>
                        <div class="codexplus-form-hint">
                            {{ __('Clique em "Abrir o fluxograma" para desenhar em tela cheia. "Salvar fluxograma", dentro do quadro, grava na hora; o resto do documento, ao clicar em Salvar.', 'codexplus') }}
                        </div>
                    </div>
                {% elseif is_diagram and diagram_kind != 'organograma' %}
                    {# D1: cronograma ou matriz RACI (public/js/codexplus-grid.js),
                       mesmo contrato do organograma: JSON em _diagram, salvamento
                       automático e o Salvar do formulário. #}
                    <div class="codexplus-doc-edit-zone cx-docform-diagram">
                        <label class="codexplus-doc-edit-zone-label">
                            <i class="ti {{ diagram_kind == 'raci' ? 'ti-table' : 'ti-calendar-time' }}"></i> {{ diagram_kind_label }}
                        </label>
                        <script type="application/json" id="cx-grid-data">{{ diagram_json|raw }}</script>
                        <input type="hidden" name="_diagram" id="cx-grid-input" value="">
                        <div data-cx-grid data-editable="1" data-sign="{{ signers_line|default('') ? __('Aprovadores', 'codexplus') ~ ': ' ~ signers_line : '' }}" data-source="cx-grid-data" data-input="cx-grid-input"
                             data-title="{{ name }}" data-code="{{ code }}"
                             data-doc="{{ id }}" data-save="{{ glpi_root }}/plugins/codexplus/ajax/diagram.save.php"></div>
                        <div class="codexplus-form-hint">
                            {# Q7b-1: no cronograma o texto vem do motor (muda com o formato: períodos ou datas). #}
                            {% if diagram_kind == 'raci' %}
                                {{ __('Clique na célula para trocar entre R, A, C, I e vazio. Clique no nome de uma atividade ou papel para editar. Cada atividade deve ter um só A.', 'codexplus') }}
                            {% else %}
                                <span data-cx-grid-hint>{{ __('Clique na célula para trocar entre vazio, período (barra) e marco. Clique no nome de uma tarefa, responsável ou período para editar.', 'codexplus') }}</span>
                            {% endif %}
                            {{ __('Gravado sozinho pouco depois de cada mudança.', 'codexplus') }}
                        </div>
                    </div>
                {% elseif is_diagram %}
                    {# Q6d (Claudio, 03/10/2026): organograma no motor de quadro.
                       A página mostra legenda, desenho e a matriz (editável aqui,
                       gravada sozinha); "Abrir o organograma" edita em tela cheia
                       (codexplus-orgdraw.js + codexplus-board.js). O hidden
                       _diagram acompanha o Salvar do formulário. #}
                    <div class="codexplus-doc-edit-zone cx-docform-diagram">
                        <label class="codexplus-doc-edit-zone-label">
                            <i class="ti ti-sitemap"></i> {{ __('Organograma', 'codexplus') }}
                        </label>
                        <script type="application/json" id="cx-org-data">{{ diagram_json|raw }}</script>
                        <input type="hidden" name="_diagram" id="cx-org-input" value="{{ diagram_json }}">
                        <div data-cx-orgview data-editable="1" data-sign="{{ signers_line|default('') ? __('Aprovadores', 'codexplus') ~ ': ' ~ signers_line : '' }}" data-source="cx-org-data" data-input="cx-org-input"
                             data-title="{{ name }}" data-code="{{ code }}"
                             data-doc="{{ id }}" data-save="{{ glpi_root }}/plugins/codexplus/ajax/diagram.save.php"
                             data-photo="{{ glpi_root }}/plugins/codexplus/front/orgphoto.send.php?doc={{ id }}"
                             data-photo-up="{{ glpi_root }}/plugins/codexplus/ajax/orgphoto.php"></div>
                        <div class="codexplus-form-hint">
                            {{ __('Clique em "Abrir o organograma" para editar em tela cheia; "Salvar organograma", dentro dele, grava na hora. A matriz de escalonamento se edita aqui e é gravada sozinha pouco depois de cada mudança; o resto do documento, ao clicar em Salvar.', 'codexplus') }}
                        </div>
                    </div>
                {% else %}
                    <div class="codexplus-doc-edit-zone codexplus-doc-edit-body" id="cx-docform-body" data-cx-doctype="{{ doctype }}"{% if docref_url %} data-cx-docref-url="{{ docref_url }}"{% endif %}>
                    <label class="codexplus-doc-edit-zone-label">
                        <i class="ti ti-article"></i> {{ __('Corpo do documento', 'codexplus') }}
                    </label>
                    {# Bloco E1: estilos fixos no editor. Normalmente já preparado ao
                       carregar codexplus-editor.js; a chamada aqui garante, antes
                       do script do GLPI que inicia o editor. #}
                    <script>window.CodexplusEditor && window.CodexplusEditor.prepare('codexplus-doc-content');</script>
                    {{ widgets.content|raw }}
                    <div class="codexplus-form-hint">
                        {{ __('Cole ou arraste imagens direto no texto. Para anexar arquivos (planilhas, PDFs, fotos), use a área de arquivos abaixo do editor. Tudo é gravado ao clicar em Salvar.', 'codexplus') }}
                    </div>
                </div>
                    {% if is_new %}
                        {# 0.6.7-2: com o tipo DIA escolhido, o corpo de texto some
                           (não é usado) e fica só o aviso do próximo passo. #}
                        <div class="cx-notice cx-notice--info" id="cx-docform-dia-hint" hidden>
                            <i class="ti ti-sitemap"></i>
                            <div>
                                <strong>{{ __('Diagrama', 'codexplus') }}</strong>
                                <div class="cx-notice-text">{{ __('Escolha o subtipo, informe o título e clique em "Criar rascunho". Na página seguinte aparece o diagrama para editar (no organograma, "Importar ou exportar" cola um organograma pronto).', 'codexplus') }}</div>
                            </div>
                        </div>
                        <script>
                        (function () {
                            var sel  = document.querySelector('select[name="doctype"]');
                            var body = document.getElementById('cx-docform-body');
                            var hint = document.getElementById('cx-docform-dia-hint');
                            if (!sel || !body || !hint) { return; }
                            var upd = function () {
                                var dia = sel.value === 'DIA';
                                body.hidden = dia;
                                hint.hidden = !dia;
                            };
                            sel.addEventListener('change', upd);
                            if (window.jQuery) { window.jQuery(sel).on('change', upd); }
                            upd();
                        })();
                        </script>
                    {% endif %}
                {% endif %}

                {% if not is_new %}
                    <div class="codexplus-doc-edit-zone cx-docform-roles">
                        <span><strong>{{ __('Setor', 'codexplus') }}:</strong> {{ sector_names ? sector_names|join(', ') : '—' }}</span>
                        <span><strong>{{ __('Autor', 'codexplus') }}:</strong> {{ author_name }}</span>
                        {% if signers_line|default('') %}
                            <span><strong>{{ __('Aprovadores', 'codexplus') }}:</strong> {{ signers_line }}</span>
                        {% endif %}
                    </div>
                {% endif %}
            </article>

            <div class="codexplus-form-actions codexplus-doc-edit-actions">
                {% if is_new %}
                    <button type="submit" name="add" value="1" class="codexplus-btn codexplus-btn-primary">
                        <i class="ti ti-plus"></i> {{ __('Criar rascunho', 'codexplus') }}
                    </button>
                {% else %}
                    <button type="submit" name="update" value="1" class="codexplus-btn codexplus-btn-primary">
                        <i class="ti ti-device-floppy"></i> {{ __('Salvar', 'codexplus') }}
                    </button>
                {% endif %}
                <a href="{{ is_new ? glpi_root ~ '/plugins/codexplus/front/dashboard.php' : self ~ '?id=' ~ id }}" class="codexplus-btn">{{ __('Cancelar', 'codexplus') }}</a>
            </div>
        </form>

    {% else %}
        {# ================= VISÃO (sem edição) ================= #}
        {# R3b3-2: os cinco seletores do PDF (CONTEXTO, seção 6) — são
           interface, não decoração. O que fica fora de #codexplus-doc (anexos,
           fluxo) não vai para o PDF; a coluna Permissões e a linha de papéis
           ficam dentro, mas o PDF só lê título e .codexplus-content. #}
        <article class="codexplus-doc" id="codexplus-doc">
            <h1 class="cx-docform-view-title codexplus-doc-title">{{ name }}</h1>
            {# HV-1 (Claudio, 04/10/2026): na leitura, a mesma barra dos dados,
               recolhida, só com a aba Histórico. O PDF só lê o título e
               .codexplus-content (CONTEXTO, seção 6): esta barra fica fora. #}
            {% if history.show %}
                {% set cx_last = history.rows|first %}
                <div class="cx-meta cx-meta--hist" data-cx-meta data-new="0" data-missing="0"
                     data-default-tab="historico" data-store="cx-hist-open"
                     data-label-open="{{ __('Ocultar histórico', 'codexplus') }}" data-label-closed="{{ __('Mostrar histórico', 'codexplus') }}">
                    <div class="cx-meta-bar">
                        <i class="ti ti-history cx-meta-ico"></i>
                        <span class="cx-meta-item">{{ __('Histórico', 'codexplus') }}</span>
                        {% if cx_last %}
                            <span class="cx-meta-item"><span>{{ __('Última alteração', 'codexplus') }}</span>
                                {{ cx_last.date|date('d/m/Y H:i') }}{% if cx_last.user %} · {{ cx_last.user }}{% endif %}</span>
                        {% endif %}
                        <button type="button" class="codexplus-btn cx-meta-toggle" data-cx-meta-toggle aria-expanded="false">
                            <i class="ti ti-chevron-down"></i> {{ __('Mostrar histórico', 'codexplus') }}
                        </button>
                    </div>
                    <div class="cx-meta-tabs" role="tablist">
                        <button type="button" role="tab" class="cx-meta-tab" data-cx-tab-btn="historico"><i class="ti ti-history"></i> {{ __('Histórico', 'codexplus') }}</button>
                    </div>
                    <div class="cx-docform-split">
                        <div data-cx-tab="historico">
                            {% include '@codexplus/parts/doc-history.html.twig' with {history: history} only %}
                        </div>
                    </div>
                </div>
            {% endif %}
            {# preview: janela "Visualizar e PDF" — só o documento, sem
               revisão periódica, Permissões nem fluxo (Claudio, 25/09/2026). #}
            <div class="cx-docform-split{{ perm.show and not preview ? ' cx-docform-split--perm' : '' }}">
            <div>
            <div class="cx-docform-roles">
                <span><strong>{{ __('Categorias', 'codexplus') }}:</strong> {{ category_names ? category_names|join(', ') : '—' }}</span>
                <span><strong>{{ __('Setor', 'codexplus') }}:</strong> {{ sector_names ? sector_names|join(', ') : '—' }}</span>
                <span><strong>{{ __('Autor', 'codexplus') }}:</strong> {{ author_name }}</span>
                <span><strong>{{ __('Responsável', 'codexplus') }}:</strong> {{ owner_name ?: '—' }}</span>
                {% if signers_line|default('') %}
                    <span><strong>{{ __('Aprovadores', 'codexplus') }}:</strong> {{ signers_line }}</span>
                {% endif %}
                {% if client.name %}
                    <span><strong>{{ __('Cliente', 'codexplus') }}:</strong> {{ client.name }}</span>
                {% endif %}
                {% if brand.show and brand.name %}
                    <span><strong>{{ __('Marca', 'codexplus') }}:</strong> {{ brand.name }}</span>
                {% endif %}
                {% if status == 'publicado' and validator_name %}
                    <span><strong>{{ __('Validado por', 'codexplus') }}:</strong> {{ validator_name }}{% if date_validated %}, {{ date_validated|date('d/m/Y') }}{% endif %}</span>
                {% endif %}
                {% if review.show and (not review.can_review or preview) %}
                    {% if review.show_auditor %}
                    <span><strong>{{ __('Auditor responsável', 'codexplus') }}:</strong> {{ review.auditor_name ?: '—' }}</span>
                    {% endif %}
                    {% if review.show_editor and not review.is_new %}
                    <span><strong>{{ __('Editores', 'codexplus') }}:</strong> {{ review.reviewer_name ?: '—' }}</span>
                    {% endif %}
                    {% if review.show_reviewer %}
                    <span><strong>{{ __('Revisor', 'codexplus') }}:</strong> {{ review.reviewer_name ?: '—' }}</span>
                    <span><strong>{{ __('Janela de revisão', 'codexplus') }}:</strong>
                        {% if review.start and review.end %}{{ review.start|date('d/m/Y') }} {{ __('a', 'codexplus') }} {{ review.end|date('d/m/Y') }}{% else %}{{ __('calculada na publicação', 'codexplus') }}{% endif %}</span>
                    {% endif %}
                {% endif %}
            </div>
            {% if review.show and review.can_review and not version.on and not preview %}
                {# R3d: fora de rascunho, quem gere o documento ainda muda
                   revisor e janela (o auditor, não: só em rascunho). #}
                <form method="post" action="{{ self }}" class="cx-review-form">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <div class="cx-docform-grid">
                        {% include '@codexplus/parts/doc-review.html.twig' with {review: review} only %}
                    </div>
                    <button type="submit" name="update_review" value="1" class="codexplus-btn">
                        <i class="ti ti-device-floppy"></i> {{ review.show_reviewer ? __('Salvar revisão periódica', 'codexplus') : __('Salvar editores', 'codexplus') }}
                    </button>
                </form>
            {% endif %}
            </div>
            {% if perm.show and not version.on and not preview %}
                {% include '@codexplus/parts/doc-permissions.html.twig' with {perm: perm, id: id, csrf_token: csrf_token, anon: anon} only %}
            {% endif %}
            </div>
            {% if is_diagram and diagram_kind == 'fluxograma' %}
                <script type="application/json" id="cx-flow-data">{{ diagram_json|raw }}</script>
                <div class="cx-docform-diagram" data-cx-flow data-editable="0" data-sign="{{ signers_line|default('') ? __('Aprovadores', 'codexplus') ~ ': ' ~ signers_line : '' }}" data-source="cx-flow-data"
                     data-title="{{ name }}" data-code="{{ code }}"></div>
            {% elseif is_diagram and diagram_kind != 'organograma' %}
                <script type="application/json" id="cx-grid-data">{{ diagram_json|raw }}</script>
                {# Q7b-4: situação das tarefas (publicado); quem pode marcar ganha Iniciar/Concluir/Reabrir. #}
                {% if schedule.on %}
                    <script type="application/json" id="cx-grid-status">{{ schedule.json|raw }}</script>
                    <script type="application/json" id="cx-grid-hist">{{ schedule.hist|raw }}</script>
                    {% if schedule.can_mark %}
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}" form="cx-grid-status-token">
                    {% endif %}
                {% endif %}
                <div class="cx-docform-diagram" data-cx-grid data-editable="0" data-sign="{{ signers_line|default('') ? __('Aprovadores', 'codexplus') ~ ': ' ~ signers_line : '' }}" data-source="cx-grid-data"
                     data-title="{{ name }}" data-code="{{ code }}"
                     {% if schedule.on %}data-status="cx-grid-status" data-hist="cx-grid-hist" data-doc="{{ id }}"{% if schedule.can_mark %} data-can-mark="1" data-status-url="{{ schedule.url }}"{% endif %}{% endif %}></div>
            {% elseif is_diagram %}
                {# Q6a-1: leitura do organograma no desenho novo, em SVG
                   (public/js/codexplus-orgdraw.js); a edição continua no motor
                   antigo até o Q6b. #}
                <script type="application/json" id="cx-org-data">{{ diagram_json|raw }}</script>
                <div class="cx-docform-diagram" data-cx-orgview data-source="cx-org-data" data-sign="{{ signers_line|default('') ? __('Aprovadores', 'codexplus') ~ ': ' ~ signers_line : '' }}"
                     data-title="{{ name }}" data-code="{{ code }}"
                     data-photo="{{ glpi_root }}/plugins/codexplus/front/orgphoto.send.php?doc={{ id }}"></div>
            {% else %}
                <div class="codexplus-content rich_text_container">{{ content_html|raw }}</div>
                {# 5b: na tela; nas folhas e no PDF quem desenha é o JS (cfg.document.complements). #}
                {% if complements is not empty %}
                    <section class="cx-complements">
                        <h2>{{ __('Documentos complementares', 'codexplus') }}</h2>
                        <table>
                            <thead><tr><th>{{ __('Código', 'codexplus') }}</th><th>{{ __('Tipo', 'codexplus') }}</th><th>{{ __('Título', 'codexplus') }}</th></tr></thead>
                            <tbody>
                            {% for c in complements %}
                                <tr>
                                    <td>{% if c.href %}<a href="{{ c.href }}">{{ c.code }}</a>{% else %}{{ c.code }}{% endif %}</td>
                                    <td>{{ c.type }}</td>
                                    <td>{% if c.href %}<a href="{{ c.href }}">{{ c.name }}</a>{% else %}{{ c.name }}{% endif %}{% if c.note %} <span class="cx-complements-note">({{ c.note }})</span>{% endif %}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </section>
                {% endif %}
                <script type="application/json" id="codexplus-print-config">{{ print_config|raw }}</script>
            {% endif %}
        </article>
        {# R7-2 (Claudio, 04/10/2026): "Visualizar" mostra as folhas como no
           PDF (public/js/codexplus.js, renderSheets). Só documento de texto:
           sem .codexplus-content o JS tira este elemento. #}
        {% if preview and not is_diagram %}
            <div class="cx-sheets" data-cx-sheets></div>
        {% endif %}
    {% endif %}


    {# Etapa 5a: documentos vinculados (PSG → POP/DIA, POP → MAN/DIA, MAN → DIA).
       Fora de #codexplus-doc: é gestão, não vai para o PDF (o PDF composto
       é a 5d). Netos aparecem em cinza, só para conferência. #}
    {% if links is not null %}
        <section class="cx-links" data-cx-links data-search="{{ links.search_url }}">
            <h2 class="codexplus-attachments-title"><i class="ti ti-hierarchy-2"></i> {{ __('Documentos vinculados', 'codexplus') }}</h2>
            {% if links.tree %}
                <ul class="cx-links-list" data-cx-links-list>
                    {% include '@codexplus/parts/doc-links-rows.html.twig' with {rows: links.tree, top: true, can_manage: links.can_manage} only %}
                </ul>
            {% else %}
                <p class="cx-perm-empty">{{ __('Nenhum documento vinculado.', 'codexplus') }}</p>
            {% endif %}
            {% if links.can_manage %}
                <form method="post" action="{{ self }}" id="cx-links-form" class="cx-links-add">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <input type="hidden" name="child_id" value="" data-cx-link-child>
                    <input type="hidden" name="link_order" value="" data-cx-link-order disabled>
                    <div class="cx-links-search">
                        <input type="search" class="form-control" data-cx-link-q autocomplete="off"
                               placeholder="{{ __('Buscar %s por código ou título', 'codexplus')|format(links.types) }}">
                        <ul class="cx-links-results" data-cx-link-results hidden></ul>
                    </div>
                    <button type="submit" name="link_add" value="1" class="codexplus-btn" data-cx-link-add disabled>
                        <i class="ti ti-plus"></i> {{ __('Vincular', 'codexplus') }}
                    </button>
                </form>
                <div class="codexplus-form-hint">{{ __('Arraste para reordenar. Os documentos em cinza vêm dos vinculados e mudam na página deles. Vale na hora, sem revisão.', 'codexplus') }}</div>
            {% endif %}
        </section>
    {% endif %}

    {# R3b3-1: anexos. FORA de #codexplus-doc de propósito: anexo é link de
       download, não vai para o PDF (decisão de 19/09/2026; imagem no PDF só
       em proposta, Etapa 3c). Tirar: só quem edita, em rascunho. #}
    {% if attachments is not empty %}
        <section class="codexplus-attachments">
            <h2 class="codexplus-attachments-title"><i class="ti ti-paperclip"></i> {{ __('Anexos', 'codexplus') }}</h2>
            <ul class="codexplus-attachments-list">
                {% for att in attachments %}
                    <li class="codexplus-attachment">
                        <a href="{{ att.url }}" target="_blank" rel="noopener">
                            <i class="ti ti-file-download"></i>
                            <span class="codexplus-attachment-name">{{ att.name }}</span>
                        </a>
                        {% if can_edit %}
                            <form method="post" action="{{ self }}" class="cx-att-del">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="id" value="{{ id }}">
                                <button type="submit" name="del_attachment" value="{{ att.link }}" class="cx-perm-del"
                                        title="{{ __('Tirar do documento', 'codexplus') }}" aria-label="{{ __('Tirar do documento', 'codexplus') }} {{ att.name }}"
                                        onclick="return confirm('{{ __('Tirar este anexo do documento? O que não foi salvo no formulário acima se perde.', 'codexplus')|e('js') }}');">
                                    <i class="ti ti-x"></i>
                                </button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {# ================= FLUXO ================= #}
    {% if not is_new and not version.on and not preview and (can_submit or can_publish_direct or can_approve or can_sign|default(false) or can_validate or can_reject or can_obsolete
        or can_open_revision or can_confirm_nochange or can_cancel_revision or can_extend_revision) %}
        <section class="cx-flow">
            <h3 class="cx-card-title">{{ __('Fluxo do documento', 'codexplus') }}</h3>

            {% if can_submit %}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    {% if revision_no > 0 %}
                        {# R6-a: numa revisão, o resumo do que mudou é obrigatório. #}
                        <textarea name="revision_summary" rows="2" class="form-control cx-flow-summary" required
                                  placeholder="{{ __('Resumo do que mudou nesta revisão (obrigatório)', 'codexplus') }}"></textarea>
                    {% endif %}
                    <button type="submit" name="submit_validation" value="1" class="codexplus-btn codexplus-btn-primary">
                        <i class="ti ti-send"></i> {{ __('Enviar para validação', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">
                        {% if flow == 'one' %}
                            {{ __('Salve antes de enviar. Vai ao responsável, que aprova e publica; nesse meio-tempo o documento fica travado.', 'codexplus') }}
                        {% else %}
                            {{ __('Salve antes de enviar. Vai primeiro ao responsável e depois ao auditor; nesse meio-tempo o documento fica travado.', 'codexplus') }}
                        {% endif %}
                    </span>
                </form>
            {% endif %}

            {% if can_publish_direct %}
                {# P2: Proposta e Laudo — o responsável publica sem etapas. #}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    {% if revision_no > 0 %}
                        <textarea name="revision_summary" rows="2" class="form-control cx-flow-summary" required
                                  placeholder="{{ __('Resumo do que mudou nesta revisão (obrigatório)', 'codexplus') }}"></textarea>
                    {% endif %}
                    <button type="submit" name="publish_direct" value="1" class="codexplus-btn codexplus-btn-primary"
                            onclick="return confirm('{{ __('Publicar este documento? Depois de publicado, mudanças só por revisão.', 'codexplus')|e('js') }}');">
                        <i class="ti ti-world-upload"></i> {{ __('Publicar', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('Salve antes de publicar. Neste tipo o responsável publica direto, sem auditoria.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_open_revision %}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <button type="submit" name="open_revision" value="1" class="codexplus-btn codexplus-btn-primary"
                            onclick="return confirm('{{ __('Abrir a revisão seguinte? O documento volta a rascunho; os leitores continuam vendo a versão publicada até a nova ser validada.', 'codexplus')|e('js') }}');">
                        <i class="ti ti-pencil-plus"></i> {{ __('Abrir revisão', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('Cria a próxima revisão para editar. A publicada segue no ar até a nova passar pelo responsável e pelo auditor.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_confirm_nochange %}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <button type="submit" name="confirm_nochange" value="1" class="codexplus-btn"
                            onclick="return confirm('{{ __('Confirmar que o documento foi revisado e continua correto? A janela de revisão será renovada a partir de hoje.', 'codexplus')|e('js') }}');">
                        <i class="ti ti-rosette-discount-check"></i> {{ __('Revisado sem alteração', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('Renova a janela sem criar nova revisão e sem passar pelo auditor.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_cancel_revision %}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <button type="submit" name="cancel_revision" value="1" class="codexplus-btn cx-btn-danger-outline"
                            onclick="return confirm('{{ __('Cancelar esta revisão? Tudo o que mudou nela será descartado e o documento volta à versão publicada.', 'codexplus')|e('js') }}');">
                        <i class="ti ti-arrow-back"></i> {{ __('Cancelar revisão', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('Descarta a revisão em andamento.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_extend_revision %}
                {# R6-b: prorrogar (ou definir) o prazo, com motivo. #}
                <form method="post" action="{{ self }}" class="cx-flow-row cx-flow-extend">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <label class="cx-flow-extend-date">
                        {{ __('Novo prazo', 'codexplus') }}
                        <input type="date" name="revision_due" required class="form-control"
                               min="{{ today_ymd }}" value="{{ revdue is not null and revdue.due ? revdue.due : '' }}">
                    </label>
                    <input type="text" name="extend_reason" required maxlength="500" class="form-control cx-flow-extend-reason"
                           placeholder="{{ __('Motivo (obrigatório)', 'codexplus') }}">
                    <button type="submit" name="extend_revision" value="1" class="codexplus-btn">
                        <i class="ti ti-calendar-plus"></i>
                        {{ revdue is not null and revdue.state == 'sem_prazo' ? __('Definir prazo', 'codexplus') : __('Prorrogar prazo', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('O motivo fica registrado na página da revisão.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_sign|default(false) %}
                {# A-2a: aprovador do diagrama. Devolver é o formulário de baixo. #}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <button type="submit" name="signer_approve" value="1" class="codexplus-btn codexplus-btn-primary"
                            onclick="return confirm('{{ __('Aprovar este documento como aprovador?', 'codexplus')|e('js') }}');">
                        <i class="ti ti-circle-check"></i> {{ __('Aprovar', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('Etapa dos aprovadores: depois do último, vai ao responsável e ao auditor.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_approve %}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <textarea name="approval_comment" rows="2" class="form-control"
                              placeholder="{{ __('Observação para o auditor (opcional)', 'codexplus') }}"></textarea>
                    <button type="submit" name="manager_approve" value="1" class="codexplus-btn codexplus-btn-primary"
                            onclick="return confirm('{{ __('Aprovar e enviar ao auditor responsável?', 'codexplus')|e('js') }}');">
                        <i class="ti ti-circle-check"></i> {{ __('Aprovar e enviar ao auditor', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('1ª etapa: aprovação do responsável.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_validate %}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <textarea name="approval_comment" rows="2" class="form-control"
                              placeholder="{{ __('Observação da auditoria (opcional)', 'codexplus') }}"></textarea>
                    <button type="submit" name="approve" value="1" class="codexplus-btn codexplus-btn-primary"
                            onclick="return confirm('{{ __('Validar e publicar este documento?', 'codexplus')|e('js') }}');">
                        <i class="ti ti-circle-check"></i> {{ __('Validar e publicar', 'codexplus') }}
                    </button>
                    <span class="codexplus-form-hint">{{ __('2ª etapa: validação do auditor responsável.', 'codexplus') }}</span>
                </form>
            {% endif %}

            {% if can_reject %}
                <form method="post" action="{{ self }}" class="cx-flow-row cx-flow-reject">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <textarea name="validation_comment" rows="2" class="form-control" required
                              placeholder="{{ __('O que corrigir (obrigatório)', 'codexplus') }}"></textarea>
                    <button type="submit" name="reject" value="1" class="codexplus-btn">
                        <i class="ti ti-arrow-back-up"></i> {{ __('Devolver para rascunho', 'codexplus') }}
                    </button>
                </form>
            {% endif %}

            {% if can_obsolete %}
                <form method="post" action="{{ self }}" class="cx-flow-row">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <button type="submit" name="obsolete" value="1" class="codexplus-btn"
                            onclick="return confirm('{{ __('Tornar este documento obsoleto?', 'codexplus')|e('js') }}');">
                        <i class="ti ti-archive"></i> {{ __('Tornar obsoleto', 'codexplus') }}
                    </button>
                </form>
            {% endif %}
        </section>
    {% endif %}

    {# R7: formulário do link anônimo, fora do formulário de edição (a
       coluna Permissões pode estar dentro dele); os botões usam form=. #}
    {% if anon is not null %}
        <form method="post" action="{{ self }}" id="cx-anon-form" hidden>
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="id" value="{{ id }}">
        </form>
    {% endif %}
</div>
